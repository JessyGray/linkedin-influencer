# LinkedIn app (linkedin.com/developers → your app → Auth)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=            # publishable (anon) key, safe because tables are locked by RLS
DB_SECRET=               # random string, same value you insert into li_private.config

# This deployment
APP_URL=https://your-publisher.vercel.app
ADMIN_KEY=               # random string, your password for /api/* (also the Custom GPT bearer token)
CRON_SECRET=             # random string, Vercel sends it with cron calls

# Optional: pin a LinkedIn API version (YYYYMM). Default is 3 months ago.
# LINKEDIN_VERSION=
